MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API / connect over Socket.IO
CLIENT_ORIGIN=http://localhost:5173

# Days of inactivity before an anonymous (unowned) snippet is auto-deleted.
# Snippets owned by a logged-in user never expire.
SNIPPET_TTL_DAYS=30

# Secret used to sign auth JWTs — generate your own, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
