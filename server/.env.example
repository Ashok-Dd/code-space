MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API / connect over Socket.IO
CLIENT_ORIGIN=http://localhost:5173

# Days of inactivity before a snippet is auto-deleted (TTL index on lastAccessed)
SNIPPET_TTL_DAYS=30
